{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "fellaship-brain",
  "title": "Fellaship Brain",
  "description": "AI-powered thought capture pro Fellaship",
  "icon": "icon.png",
  "author": "vojta",
  "license": "MIT",
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "capture",
      "title": "Capture Thought",
      "description": "Zachyť a klasifikuj myšlenku",
      "mode": "view"
    },
    {
      "name": "list",
      "title": "Browse Thoughts",
      "description": "Procházej a konzultuj myšlenky",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiUrl",
      "title": "Brain API URL",
      "description": "URL tvého brain-api serveru",
      "type": "textfield",
      "required": true,
      "default": "http://127.0.0.1:8765"
    },
    {
      "name": "authToken",
      "title": "Auth Token",
      "description": "Bearer token pro brain-api",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.78.0",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
