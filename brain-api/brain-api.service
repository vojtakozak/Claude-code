[Unit]
Description=Fellaship Brain API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/brain-api
EnvironmentFile=/opt/brain-api/.env
ExecStart=/opt/brain-api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
